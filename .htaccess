# Reformas Khali · configuración del servidor (Apache, Webempresa).
# GitHub Pages no lee este archivo: solo sirve en la web publicada.

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Una sola dirección: siempre con www. (El paso de http a https lo hace wePanel con «Forzar redirección HTTPS».)
  RewriteCond %{HTTP_HOST} ^reformaskhali\.es$ [NC]
  RewriteRule ^ https://www.reformaskhali.es%{REQUEST_URI} [R=301,NE,L]

  # Direcciones de la web antigua (WordPress) que ya no existen → su sitio nuevo.
  # «servicios», «proyectos-realizados», «contacto», «politica-privacidad» y «politica-de-cookies» se llaman igual.
  RewriteRule ^quienes-somos/?$ https://www.reformaskhali.es/#nosotros [R=301,NE,L]
  RewriteRule ^politica-de-privacidad/?$ https://www.reformaskhali.es/politica-privacidad/ [R=301,L]
  RewriteRule ^feed/?$ https://www.reformaskhali.es/ [R=301,L]
  RewriteRule ^(category|tag|author)/ https://www.reformaskhali.es/ [R=301,L]
  RewriteRule ^[0-9]{4}/[0-9]{2}/ https://www.reformaskhali.es/ [R=301,L]
</IfModule>

# No enseñar archivos internos si alguno se sube por error.
<FilesMatch "\.(md|py|json|txt)$">
  Require all denied
</FilesMatch>
<Files "robots.txt">
  Require all granted
</Files>
<Files "LICENCIAS.txt">
  Require all granted
</Files>

# Caché: fotos, fuentes, estilos y código, un mes; las páginas, 10 minutos.
# Las páginas necesitan algo de caché: si caducan al instante, la Microcache del servidor tarda 5 s en servirlas.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
